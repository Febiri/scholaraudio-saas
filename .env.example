# ==========================================
# ProfFeb SaaS - Environment Template
# ==========================================

# 1. Google Gemini API (Free Tier)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# 2. Supabase Integration (Multi-Tenant Authentication & Cloud Database)
# Create a free project at https://supabase.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here
# Optional PostgreSQL connection URI:
# DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres

# 3. Zotero Web API Integration (Optional / Fallback)
# Find User ID at: https://www.zotero.org/settings/keys
ZOTERO_LIBRARY_ID=
ZOTERO_API_KEY=
ZOTERO_LIBRARY_TYPE=user

# 4. Text-to-Speech Voice (Free Microsoft Edge Neural TTS)
DEFAULT_TTS_VOICE=en-NG-AbeoNeural

# 5. GitHub Integration (Optional for Academic Co-Pilot)
GITHUB_TOKEN=
GITHUB_USERNAME=
